{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spark KeyGen",
  "version": "1.0.0",
  "identifier": "com.spark.keygen",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Spark — Generador de claves (privado)",
        "width": 600,
        "height": 680,
        "minWidth": 520,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
